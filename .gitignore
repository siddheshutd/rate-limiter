# What lives here is source plus the scripts that generate everything else at run time. So the rule
# for this file is: if a script can recreate it, it does not belong in the repo. A clone needs
# README.md, pom.xml, gateway-service/src/, redis/*.conf and scripts/*.sh — nothing below.

# --- Build output -----------------------------------------------------------
# Regenerated by ./scripts/two-gateways.sh build (mvn package), and the jar is a 30 MB binary whose
# diffs are useless.
target/
*.class
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# With a Maven wrapper, commit .mvn/wrapper/maven-wrapper.properties (it pins the version) and leave
# the downloaded jar out; the wrapper fetches it again on first build.
.mvn/wrapper/maven-wrapper.jar

# --- Runtime state the scripts create ---------------------------------------
# .redis-standalone/ and .redis-cluster/ are written by scripts/redis-standalone.sh and
# scripts/redis-cluster.sh: per-node redis.conf (sed'd from redis/redis-cluster-node.conf), the AOF,
# nodes.conf, logs and pidfiles. redis-cluster.sh start rebuilds all of it, and committing a
# nodes.conf or an AOF would hand the next person a half-formed cluster from someone else's machine.
.redis-standalone/
.redis-cluster/

# .run/ holds the gateway pidfiles and stdout (nohup redirects there).
.run/

# Snapshot files Redis writes when a node is started without --dir pointing at a data directory.
dump.rdb
*.rdb
appendonlydir/
appendonly.aof
*.aof
*.pid

# --- Local config overrides & credentials -----------------------------------
# application.yaml holds only demo fixtures (tok_free_alice / tok_paid_bob), so it is committed.
# Anything machine-specific or real goes in these instead.
.env
.env.*
application-local.yaml
application-local.yml
*-local.yaml
*.pem
*.key
.jqwik/

# --- OS & editors -----------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~

# --- Logs -------------------------------------------------------------------
# Redis logs live inside the ignored data directories; this catches anything written alongside the
# scripts (demo output redirects, a stray nohup.out).
*.log
nohup.out
